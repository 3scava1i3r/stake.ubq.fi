# Example environment configuration for Vite
# Copy this file to one of the following depending on your workflow:
# - .env (loaded in all modes)
# - .env.dev (used with: vite --mode dev)
# - .env.prod (used with: vite build --mode prod)
# - .env.local-node (used with: vite --mode local-node)

# Build mode indicator (optional for Vite)
NODE_ENV=development

# RPC endpoint for Ubiquity chain (public default shown)
VITE_RPC_URL=https://rpc.ubq.fi

# WalletConnect Cloud project ID (get from cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=YOUR_PROJECT_ID

# For local-node mode, you can override in .env.local-node:
# VITE_RPC_URL=http://localhost:8545
